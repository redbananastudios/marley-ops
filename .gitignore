# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# e2e (Playwright) — captured artefacts + stored auth sessions never committed
/e2e/artefacts/
/e2e/fixtures/.auth/
/test-results/
/playwright-report/

# QA audit — throwaway seed/read-back/storageState scripts written to the repo
# root (ESM resolution needs node_modules, /tmp doesn't have it); always
# deleted by whichever agent wrote them, never meant to be committed. Role
# agents have used both a leading-dot prefix and a leading-underscore prefix
# for these — ignore both rather than chase every naming variant.
.qa-*
_qa_*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.private/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
